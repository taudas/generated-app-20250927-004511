{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "default",
  "compatibility_date": "2026-08-05",
  "main": "./src/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "wcbn.stream",
      "custom_domain": true
    },
    {
      "pattern": "www.wcbn.stream",
      "custom_domain": true
    }
  ]
}